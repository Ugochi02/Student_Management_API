exports.uploadGallery = async (req, res) => {
    try {

        const student = await Student.findByPk(req.params.id);

        if (!student) {
            deleteFiles((req.files || []).map(file => file.filename));

            return res.status(404).json({
                message: 'Student not found'
            });
        }

        const newImages = (req.files || []).map(
            file => file.filename
        );

        const gallery = [
            (student.galleryImages || []), newImages
        ];

        await student.update({
            galleryImages: gallery
        });

        res.status(200).json({
            message: 'Gallery uploaded successfully',
            galleryImages: gallery
        });

    } catch (error) {

        deleteFiles((req.files || []).map(file => file.filename));

        res.status(500).json({
            message: error.message
        });

    }
};

exports.uploadDifferentImages = async (req, res) => {
    const files = req.files || {};

    const uploaded = Object.values(files).flat().map(file => file.filename);

    try {

        const student = await Student.findByPk(req.params.id);

        if (!student) {
            deleteFiles(uploaded);

            return res.status(404).json({
                message: 'Student not found'
            });
        }

        const gallery = [
            (student.galleryImages || []),
            (files.galleryImages || []).map(file => file.filename)
        ];

        const updates = {};

        if (files.passportImage) {
            updates.passportImage = files.passportImage[0].filename;
        }

        if (files.identityCardImage) {
            updates.identityCardImage = files.identityCardImage[0].filename;
        }

        if (files.profileImage) {
            updates.profileImage = files.profileImage[0].filename;
        }

        if (files.galleryImages) {
            updates.galleryImages = gallery;
        }

        const oldImages = [];

        if (files.passportImage && student.passportImage) {
            oldImages.push(student.passportImage);
        }

        if (files.identityCardImage && student.identityCardImage) {
            oldImages.push(student.identityCardImage);
        }

        if (files.profileImage && student.profileImage) {
            oldImages.push(student.profileImage);
        }

        await student.update(updates);

        deleteFiles(oldImages);

        res.status(200).json({
            message: 'Images uploaded successfully',

            uploadedImages: {
                passportImage: files.passportImage || [],
                identityCardImage: files.identityCardImage || [],
                profileImage: files.profileImage || [],
                galleryImages: files.galleryImages || []
            },

            student
        });

    } catch (error) {

        deleteFiles(uploaded);

        res.status(500).json({
            message: error.message
        });

    }
};