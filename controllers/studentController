exports.updateStudent = async (req, res) => {
    try {
        const id = req.params.id;
        const { fullName, email, phone, department } = req.body;
        
        const student = await Student.findByPk(id);

        if (!student) {
            if (req.file) deleteFiles([req.file.filename]);

            return res.status(404).json({
                message: 'Student not found'
            });
        }

        const data = {
            fullName, 
            email, 
            phone, 
            department
        }

        if (req.file) {
            const oldFilePath = student.profileImage
            fs.unlinkSync(oldFilePath);
            data.profileImage = req.file.path
        }


        const oldImage = student.profileImage;

        await student.update(data) 

        profileImage: req.file? req.file.filename: student.profileImage

        if (req.file && oldImage) {
            deleteFiles([oldImage]);
        }



        res.status(200).json({
            message: "Student Updated Successfully",
            data: student
        })
    } catch (error) {
        if (req.file) deleteFiles([req.file.filename]);
        res.status(500).json({
            message: error.message
        })
    }
}

